# Database (Vercel Postgres or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/scrapeflow?sslmode=require"

# Optional: For scheduled jobs (use Vercel Cron or external service)
CRON_SECRET="your-secret-key-for-cron-endpoints"

# Optional: Proxy configuration for scraping
PROXY_URL=""
PROXY_USERNAME=""
PROXY_PASSWORD=""

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# App URL (for webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
